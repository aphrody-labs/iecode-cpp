{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "$comment": "Single vcpkg manifest for every C/C++ project in this workspace.",
  "name": "iecode-workspace",
  "version-string": "2026-09-22",
  "description": "Unified native dependencies for IECODE and emulator adapters",
  "builtin-baseline": "6e856794aebd1ee877acb74c9264d9552903c6fe",
  "dependencies": [
    "assimp", "bgfx", "bullet3", "capstone", "cli11", "directxtex",
    "enet", "faad2", "fmt", "gtest", "libarchive", "libslirp", "libwebp",
    "lua", "nlohmann-json", "pkgconf",
    "sol2", "spdlog", "tree-sitter", "zstd", "glm", "zlib", "openssl",
    "opengl", "wayland", "egl", "libx11",
    {"name": "cpp-httplib", "features": ["openssl"]},
    {"name": "sdl2", "platform": "linux"},
    {"name": "ecm", "platform": "linux"},
    {"name": "dirent", "platform": "windows"},
    {"name": "pkgconf", "host": true}
  ],
  "features": {
    "qt6": {
      "description": "Qt 6 frontend dependencies used by winDS",
      "dependencies": [
        {"name": "qtbase", "default-features": false, "features": ["gui", "network", "png", "thread", "widgets", "opengl", "zstd", "harfbuzz"]},
        {"name": "qtbase", "platform": "linux", "default-features": false, "features": ["dbus", "xcb", "xkb", "xcb-xlib", "freetype", "fontconfig"]},
        {"name": "qtmultimedia", "default-features": false, "features": ["widgets"]},
        {"name": "qtmultimedia", "platform": "linux", "default-features": false, "features": ["gstreamer"]},
        "qtsvg"
      ]
    }
  }
}
